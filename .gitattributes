# ============================================================
# VM Lifecycle Toolkit — .gitattributes
# ============================================================

# Default: let Git detect text files and auto-normalize line endings
* text=auto

# ---------- Text files — force LF (Unix line endings) ----------
# Needed by Packer / Terraform / Ansible / shell scripts that
# would break with CRLF (shebangs, heredocs, YAML parsing, etc.)

# Infrastructure as Code
*.hcl         text eol=lf
*.pkr.hcl     text eol=lf
*.pkrtpl.hcl  text eol=lf
*.pkrvars.hcl text eol=lf
*.tf          text eol=lf
*.tfvars      text eol=lf

# Shell scripts
*.sh          text eol=lf
*.bash        text eol=lf

# Configuration
*.yaml        text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.toml        text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf

# Documentation
*.md          text eol=lf
*.txt         text eol=lf
LICENSE       text eol=lf
README.md     text eol=lf

# ---------- Text files — force CRLF (Windows-specific) ----------
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf
*.xml         text eol=crlf

# ---------- Binary files (no line-ending conversion) ----------
# Installer / package formats
*.deb binary
*.rpm binary
*.msi binary
*.iso binary
*.exe binary
*.dll binary
*.so  binary
*.dylib binary

# Archives
*.zip binary
*.tar binary
*.gz  binary
*.bz2 binary
*.xz  binary
*.7z  binary

# Documents / media
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary

# ---------- GitHub archive exports: exclude from zip downloads ----------
.github       export-ignore
.gitattributes export-ignore
.gitignore    export-ignore
