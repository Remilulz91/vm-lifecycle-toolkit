<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ inventory_hostname }} — VM Lifecycle Toolkit</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; color: #222; }
  code { background: #f4f4f4; padding: 0.1rem 0.3rem; border-radius: 3px; }
  footer { margin-top: 2rem; color: #888; font-size: 0.85rem; }
</style>
</head>
<body>
  <h1>🚀 {{ inventory_hostname }}</h1>
  <p>{{ webserver_welcome_message }}</p>
  <p>
    Server name: <code>{{ webserver_server_name }}</code><br>
    Doc root: <code>{{ webserver_document_root }}</code><br>
    Deployed by Ansible role <code>webserver</code>.
  </p>
  <footer>VM Lifecycle Toolkit — V3.7.3</footer>
</body>
</html>
